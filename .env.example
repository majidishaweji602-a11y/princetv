# ---------- Frontend (public, bundled into the site: NEVER put secrets here) ----------
VITE_DRAMABOX_API_URL=https://zimbox-api.top.co.zw/api/dramabox
VITE_IPTV_API_URL=https://hostifytv.tcroneb-script.workers.dev

# Optional URL templates, only if your DramaBox API offers them. Leave empty otherwise.
#   {q} is replaced by the search text, {id} by the drama id.
VITE_DRAMA_SEARCH_URL=
VITE_DRAMA_DETAIL_URL=

# ---------- Backend (server/index.mjs, admin dashboard) ----------
PORT=8787
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
